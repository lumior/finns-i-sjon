# Server
PORT=3000
NODE_ENV=development

# JWT Secret — BYT UT DETTA i produktion!
# BYT UT DETTA till en riktigt lång slumpmässig sträng (minst 64 tecken)
# Generera med: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=byt-ut-denna-till-en-lång-slumpmässig-sträng-minst-64-tecken

# SQLite fallback (används om MariaDB inte är tillgänglig)
DB_PATH=./database/game.db

# MariaDB / MySQL (avkommentera dessa rader för att använda MariaDB)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=finnsisjon
# DB_PASSWORD=ditt_säkra_lösenord
# DB_NAME=finns_i_sjon
# DB_FALLBACK=false

# Rate limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
