{
  "name": "finns-i-sjon-pro",
  "version": "2.0.0",
  "description": "Top-notch multiplayer card game 'Finns i sjön'",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "init-db": "node -e \"require('./server/config/database')\"",
    "test": "jest --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit",
    "lint": "eslint server/ tests/",
    "lint:fix": "eslint server/ tests/ --fix",
    "format": "prettier --write \"server/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"server/**/*.js\" \"tests/**/*.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.22.3",
    "pg": "^8.20.0",
    "socket.io": "^4.6.1",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "nodemon": "^3.0.1",
    "prettier": "^3.8.3"
  }
}
